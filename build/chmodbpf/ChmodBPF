#!/bin/bash
# Grants /dev/bpf* read/write to the access_bpf group so packet-capture
# tools (SSO Watcher, Wireshark, tcpdump) can run as a normal user.
# Runs at boot via the org.sso-watcher.ChmodBPF LaunchDaemon.

# /dev/bpf* devices may not exist immediately at very early boot.
for i in 1 2 3 4 5; do
    if ls /dev/bpf* > /dev/null 2>&1; then break; fi
    sleep 1
done

chgrp access_bpf /dev/bpf* 2>/dev/null
chmod g+rw       /dev/bpf* 2>/dev/null
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ)  ChmodBPF applied to $(ls /dev/bpf* 2>/dev/null | wc -l | tr -d ' ') devices"
exit 0

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.sso-watcher.ChmodBPF</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/SSO Watcher/ChmodBPF/ChmodBPF</string>
    </array>
    <key>StandardOutPath</key>
    <string>/var/log/sso-watcher-chmodbpf.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/sso-watcher-chmodbpf.log</string>
</dict>
</plist>
